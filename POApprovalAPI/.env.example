# Local Ex-Im credentials for FIBC Buyers sync (gitignored).
# Marketing: https://www.ex-im.com/  |  Member login: https://www.ex-im.cloud/login
# Password is never returned by the API or logged. Prefer Downloads CSV → Import over Sync.
EXIM_USERNAME=info@hpbl.in
EXIM_PASSWORD=

# Gupshup WhatsApp API key (daily reports PDF at 7 PM). Also set Gupshup:SourceNumber,
# Gupshup:AppName and Gupshup:DailyReportTemplateId in appsettings.json (or Gupshup__* env vars on Render).
GUPSHUP_API_KEY=
